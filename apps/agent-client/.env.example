# 智谱 OpenAI 兼容接入配置
# 重要：密钥禁止硬编码进代码；放本文件（.env，已被 .gitignore 忽略）或系统环境变量。

# ── 开发态（推荐）：启用 Vite 代理，密钥仅在服务端注入，不进浏览器 ──
ZHIPU_PROXY=/zhipu

# 直连模式（自托管 / 测试）时：注释掉 ZHIPU_PROXY，并填写下面两项
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_API_KEY=your-api-key-here
# 多 Key 池（429 自动剔除冷却）：逗号分隔
# ZHIPU_API_KEYS=key1,key2

# ── 模型与额度 ──
# 根据智谱资源包可用模型设置：主模型 glm-4.6v / 兜底 glm-4.5-air
ZHIPU_PRIMARY_MODEL=glm-4.6v
ZHIPU_FALLBACK_MODEL=glm-4.5-air
# 约 2000 万 token 额度；超限自动降级兜底模型
ZHIPU_TOKEN_BUDGET=20000000

# ── 每百万 token 单价（USD，可选；留空=费用未知）──
# ZHIPU_PRICE_glm_4_6v_INPUT=10
# ZHIPU_PRICE_glm_4_6v_OUTPUT=22
# ZHIPU_PRICE_glm_4_5_air_INPUT=1
# ZHIPU_PRICE_glm_4_5_air_OUTPUT=2
