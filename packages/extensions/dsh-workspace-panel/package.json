{
  "name": "@deepseek-ai/dsh-workspace-panel",
  "description": "Workspace file manager + collapsible right preview panel (multi-tab file preview, built-in browser slot) for the DSH web UI. Mounts into the shell.overlay slot so it never touches the official layout kernel.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/dsh-workspace-panel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ]
}
